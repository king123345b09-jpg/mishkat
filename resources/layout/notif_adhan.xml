<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/notif_bg">
  <ImageView
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:src="@mipmap/ic_launcher_round" />
  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="حان الآن موعد"
        android:textColor="#F4C430"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/a_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/a_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:textColor="#E8DDB5"
        android:textSize="13sp" />
  </LinearLayout>
  <TextView
      android:id="@+id/a_stop"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/stop_btn"
      android:paddingLeft="22dp"
      android:paddingRight="22dp"
      android:paddingTop="9dp"
      android:paddingBottom="9dp"
      android:text="إيقاف"
      android:textColor="#FFFFFF"
      android:textSize="15sp"
      android:textStyle="bold" />
</LinearLayout>
